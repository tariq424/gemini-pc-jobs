224:SHIFTS = (3.0, -3.0, 6.0, -6.0, 10.0, -10.0)
225:WIDE = 10.0   # seconds downloaded either side of a remote excerpt, so it can move
228:def _best_framed(local, start, duration, dest, total, req, log):
229:    """owner, 2026-11-19: an excerpt with no whole face in most frames (a camera mid-move: hands and black, a body with the
230:    face cut off) is moved to the nearest well-framed moment within 10 s. When none is framed but nearby footage does show
231:    faces, the excerpt is refused (the ladder goes on). Footage with no faces anywhere (slides, a demo) is kept as it is.
232:    -> the start used."""
233:    from . import reframe
234:    try: score = reframe.framing(dest)
235:    except Exception: return start
236:    if score >= reframe.FRAMED_OK: return start
237:    best = (score, start); tmp = dest.with_name(dest.stem + "_try" + dest.suffix)
238:    try:
239:        for d in SHIFTS:
240:            s2 = start + d
241:            if s2 < 0 or s2 + min(duration, 2.0) > total: continue
242:            media.ff("-ss", s2, "-i", local, "-t", min(duration, total - s2), "-an", "-vf", "fps=30,scale=960:-2",
243:                     "-c:v", "libx264", "-crf", 20, "-pix_fmt", "yuv420p", tmp, timeout=120)
244:            sc = reframe.framing(tmp)
245:            if sc > best[0]:
246:                best = (sc, s2); tmp.replace(dest)
247:            if sc >= reframe.FRAMED_OK: break
248:    finally:
249:        tmp.unlink(missing_ok=True)
250:    sc, s2 = best
251:    if 0 < sc < reframe.FRAMED_MIN:   # faces nearby, none framed
252:        raise ValueError(f"no well-framed moment near {start:.1f}s (best {sc:.0%} of frames show a whole face)")
253:    if s2 != start:
254:        log(f"  source excerpt moved {s2 - start:+.0f}s to a well-framed moment (whole face in {sc:.0%} of frames, was {score:.0%})")
255:    return s2
