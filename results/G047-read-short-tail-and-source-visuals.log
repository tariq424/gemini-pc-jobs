96:def has_person(text, ents):
97:    """True when the narration names a real person from the story's entity list (cloud is skipped for those beats)."""
98:    low = " " + re.sub(r"[^a-z0-9 ]+", " ", (text or "").lower()) + " "
99:    for e in ents or []:
100:        if e.get("kind") != "person": continue
101:        parts = [w for w in re.sub(r"[^a-z0-9 ]+", " ", str(e.get("name", "")).lower()).split() if len(w) > 2]
102:        if parts and (f" {' '.join(parts)} " in low or f" {parts[-1]} " in low): return True
103:    return False
